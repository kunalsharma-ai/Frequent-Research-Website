# Settings for docker-compose.yml (copy to .env). The website itself needs no secrets.

# Long random string that signs CAPTCHA challenges and admin sign-ins and hashes IPs. REQUIRED.  (openssl rand -hex 32)
REVIEW_SECRET=
# Build 78.4: encrypts the connection keys typed in the admin panel (Connections & keys). Long random string,
# never change it once keys are saved (a backup restore needs the same value). Empty = REVIEW_SECRET is used.
KEYS_SECRET=
# Admin accounts (build 78.3): there is no default login. After the first start, make the first Super Admin with
#   docker compose exec backend npm run admin -- create-super-admin --email you@frequentresearch.com --name "Your Name"
# and open the one-time link it prints (or emails). Only these email domains can be admins (comma separated):
ADMIN_EMAIL_DOMAINS=frequentresearch.com
# Password of the MongoDB container (docker compose creates the database with it on first start). REQUIRED.
# Build 82.1: this root account is for maintenance only; the API uses MONGO_APP_PASSWORD (user "frapp", read and
# write on MONGODB_DB only). Use two different long random values.  (openssl rand -hex 24)
MONGO_PASSWORD=
MONGO_APP_PASSWORD=
# Build 82.1: encrypts tax and bank numbers and every onboarding document in the database (lib/vault.js).
# Long random string (openssl rand -hex 32). KEEP IT SAFE AND BACKED UP SEPARATELY FROM THE DATABASE: without it
# that data cannot be read. Empty = KEYS_SECRET, else REVIEW_SECRET is used. To change it: old value in DATA_KEY_OLD,
# new one in DATA_KEY, then  docker compose exec backend npm run admin -- reseal-onboarding
DATA_KEY=
DATA_KEY_OLD=
# Build 82: shared secret the client and vendor onboarding portals sign their deliveries with (or set it in the
# admin under Connections & keys). Same value as WEBSITE_SECRET in each portal.
ONBOARDING_SECRET=
# Optional: a hosted MongoDB instead of the container (e.g. mongodb+srv://user:pass@cluster.mongodb.net/)
MONGODB_URI=
MONGODB_DB=frequentresearch
# auto = publish clean reviews at once (links and spam words always wait); manual = every review waits for approval
PUBLISH_MODE=manual
# Forms, downloads, careers and chats are saved in MongoDB. Optional https:// address that also receives each lead
# as JSON (CRM, Zapier "Catch Hook", email relay). LEADS=off if another service answers /api/v1/enquiry.
LEAD_WEBHOOK=
LEADS=on
# Largest file the super admin can upload (photos, PDFs, videos), in MB
UPLOAD_MB=20
# Number of proxies in front of the backend (the frontend nginx is one; add one per load balancer / Cloudflare)
TRUST_PROXY=1
# Port the website is published on
WEB_PORT=8080
# Build 82.5: ready = use the ready-built website in frontend/dist/ (go-live package, starts in 1-2 minutes, recommended)
#             build = build the website from source on the server (60-120 minutes, needs about 4 GB memory)
FRONTEND_MODE=ready
# Only for FRONTEND_MODE=build: 1 = write one HTML page per route for search engines (recommended); 0 = quick build
PRERENDER=1

# ---- Build 78: email, newsletters, social media, AI, SampCrew (all optional; see docs/go-live/12-MARKETING-AND-KEYS.md)
# The site's public address, used in email links and in the CV links sent to SampCrew
PUBLIC_URL=https://www.frequentresearch.com
# Email: sender, reply-to, team addresses told about every new lead (comma-separated)
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_NOTIFY=
# smtp | resend | sendgrid | brevo | off  (empty = chosen from the keys below)
MAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=
MAIL_PER_MINUTE=60
# AI assistant (blogs, case studies, emails, social posts, ads, video scripts)
ANTHROPIC_API_KEY=
AI_MODEL=
# Social media: only the platforms you use
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
IG_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# https:// address that receives every post as JSON (Buffer, Zapier, Make, other platforms)
SOCIAL_WEBHOOK=
# SampCrew HR system: careers applications are sent there
SAMPCREW_API_URL=
SAMPCREW_API_KEY=
SAMPCREW_WEBHOOK_SECRET=
