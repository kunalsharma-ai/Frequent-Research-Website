{
  "name": "frequent-research-backend",
  "version": "82.6.0",
  "private": true,
  "type": "module",
  "description": "Frequent Research API v1 (Express + MongoDB): forms and downloads, careers, reviews and CAPTCHA, live chat, site content, uploads, visits, super admin.",
  "engines": {
    "node": ">=24"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "import-files": "node tools/import-files.js",
    "admin": "node --env-file-if-exists=.env tools/admin.js",
    "backup": "node --env-file-if-exists=.env tools/backup.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.6.0",
    "busboy": "1.6.0",
    "express": "5.3.0",
    "mongodb": "6.21.0",
    "nodemailer": "10.4.0"
  }
}
