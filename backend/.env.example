# backend settings for `npm run dev` (copy to backend/.env). In Docker they come from docker-compose.yml.
PORT=8787
# MongoDB (all data lives here: leads, careers CVs, reviews, chats, visits, uploaded files, every admin change)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=frequentresearch
# Long random string that signs CAPTCHA challenges and admin sign-ins and hashes IPs. REQUIRED in production.
REVIEW_SECRET=
# Build 78.4: encrypts the keys typed in the admin panel (Connections & keys). Empty = REVIEW_SECRET is used.
KEYS_SECRET=
# Admin accounts (build 78.3): personal accounts with password + authenticator, no shared login. Make the first
# Super Admin with:  npm run admin -- create-super-admin --email you@frequentresearch.com --name "Your Name"
# Only these email domains can be admins (comma separated):
ADMIN_EMAIL_DOMAINS=frequentresearch.com
# The site's address (setup links in emails point here)
PUBLIC_URL=http://localhost:5173
PUBLISH_MODE=manual
LEAD_WEBHOOK=
LEADS=on
# Largest file the super admin can upload, in MB
UPLOAD_MB=20
# proxies in front of the API (Vite dev server or nginx = 1)
TRUST_PROXY=1
# DEV=1: forms are only logged to the console (local testing)
DEV=

# ---- Build 78: email, newsletters, social media, AI, SampCrew (all optional; see docs/go-live/12-MARKETING-AND-KEYS.md)
# The site's public address, used in email links and in the CV links sent to SampCrew
PUBLIC_URL=https://www.frequentresearch.com
# Email: sender, reply-to, team addresses told about every new lead (comma-separated)
MAIL_FROM=
MAIL_REPLY_TO=
MAIL_NOTIFY=
# smtp | resend | sendgrid | brevo | off  (empty = chosen from the keys below)
MAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=0
RESEND_API_KEY=
SENDGRID_API_KEY=
BREVO_API_KEY=
MAIL_PER_MINUTE=60
# AI assistant (blogs, case studies, emails, social posts, ads, video scripts)
ANTHROPIC_API_KEY=
AI_MODEL=
# Social media: only the platforms you use
FB_PAGE_ID=
FB_PAGE_TOKEN=
IG_USER_ID=
IG_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# https:// address that receives every post as JSON (Buffer, Zapier, Make, other platforms)
SOCIAL_WEBHOOK=
# SampCrew HR system: careers applications are sent there
SAMPCREW_API_URL=
SAMPCREW_API_KEY=
SAMPCREW_WEBHOOK_SECRET=
